{
  "$schema": "./manifest.schema.json",
  "name": "Font Manager",
  "identifier": "org.fontmanager.sketch",
  "description": "Activates the fonts of a document from your Font Manager library when it opens.",
  "author": "Font Manager",
  "compatibleVersion": "70",
  "bundleVersion": 1,
  "commands": [
    {
      "name": "Font Manager document events",
      "identifier": "org.fontmanager.sketch.documents",
      "script": "plugin.js",
      "handlers": {
        "actions": {
          "OpenDocument": "onOpenDocument",
          "CloseDocument": "onCloseDocument"
        }
      }
    }
  ]
}
