{
  "name": "font-manager",
  "private": true,
  "type": "module",
  "license": "MIT OR Apache-2.0",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "pnpm lint:rust && pnpm lint:js",
    "lint:rust": "cargo fmt --all --check && cargo clippy --workspace --all-targets --all-features -- -D warnings && cargo deny check",
    "lint:js": "eslint . && prettier --check . && pnpm -r --if-present typecheck",
    "format": "cargo fmt --all && prettier --write .",
    "test": "pnpm -r --if-present test && node --test \"scripts/harness/**/*.test.mjs\" \"scripts/reference-library/*.test.mjs\" \"scripts/bench/*.test.mjs\" \"scripts/release/*.test.mjs\"",
    "test:e2e": "pnpm --filter @fm/desktop test:e2e",
    "dashboard": "node scripts/harness/dashboard/server.mjs",
    "gen:types": "cargo run -q -p fm-api --features gen --bin gen-types -- apps/desktop/src/api/types.ts",
    "dev": "pnpm --filter @fm/desktop tauri dev",
    "tauri": "pnpm --filter @fm/desktop tauri"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.11.1",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  }
}
