# Rust
target/

# bench workflow: the reference library restored from the CI cache
.cache/

# Node / pnpm
node_modules/
dist/

# The fm-mcp-stdio sidecar copied by scripts/release/sidecar.mjs (Tauri externalBin)
apps/desktop/src-tauri/binaries/

# Dev builds gathered by scripts/release/dev-build.mjs
nightly-assets/

# go-harness: logs, telemetry, reviews, notes, CI verdicts, screenshots (never committed)
.harness/
.review-diff.patch

# Playwright
test-results/
playwright-report/

# environment / secrets
.env
.env.*
!.env.example

# editors and OS
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
.DS_Store
Thumbs.db

# User docs site, built from docs/user by scripts/docs/build-site.mjs
apps/desktop/public/help/

# Tauri build output (schemas are regenerated on every build)
apps/desktop/src-tauri/gen/

# cargo-fuzz build output and generated corpus (crates/*/fuzz)
crates/*/fuzz/target/
crates/*/fuzz/corpus/
crates/*/fuzz/artifacts/
crates/*/fuzz/coverage/
