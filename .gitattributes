# One line ending everywhere, so rustfmt, Prettier and the types.ts diff check
# give the same answer on Windows, macOS and Linux.
* text=auto eol=lf
*.ps1 text eol=lf
*.png binary
*.ico binary
*.icns binary
*.ttf binary
*.otf binary
*.ttc binary
*.woff binary
*.woff2 binary
*.pfb binary
# Fuzz inputs are raw bytes: never normalize their line endings.
crates/*/fuzz/seeds/** binary
# The updater test package is signed byte for byte.
apps/desktop/src-tauri/tests/fixtures/updater/** binary
# The E32.1 document fixtures are raw bytes from scripts/build-document-fixtures.mjs.
fixtures/documents/** binary
fixtures/documents/README.md text eol=lf diff merge
